{
  "id": "end_com_groups",
  "files": [
    {
      "name": "end_com_groups.ref.h",
      "format": [
        "#ifndef ENDIAN_BASE_REFLECTIONS_END_COM_GROUPS_H_",
        "#define ENDIAN_BASE_REFLECTIONS_END_COM_GROUPS_H_",
        "",
        "#include \"base/end_coms.h\"",
        "",
        "__PREPROC__",
        "",
        {
          "tag": "end_com_group",
          "format": [
            "// %B",
            "struct end_com_group_%n_%d {",
            "%{  struct end_com_%l %l;  // %B%}",
            "};",

            "void end_com_group_%n_%d_new(struct end_com_group_%n_%d* coms);",
            "void end_com_group_%n_%d_cleanup(struct end_com_group_%n_%d* coms);",
            "void* end_com_group_%n_%d_get_com(struct end_com_group_%n_%d* coms, enum end_com_id com_id);"
          ]
        },
        "",
        "#endif"
      ]
    },

    {
      "name": "end_com_groups.ref.c",
      "format": [
        "#include \"end_com_groups.ref.h\"",
        "",
        "#include <log.h>",
        "",
        "// forward declarations",
        {
          "tag": "end_com_group",
          "format": [
            "%{void end_com_%l_new(struct end_com_%l* x);  // %B%}",
            "%{void end_com_%l_cleanup(struct end_com_%l* x);  // %B%}"
          ]
        },
        {
          "tag": "end_com_group",
          "format": [
            "void",
            "end_com_group_%n_%d_new(struct end_com_group_%n_%d* coms) {",
            "%{  end_com_%l_new(&coms->%l);  // %B%}",
            "}"
          ]
        },
        {
          "tag": "end_com_group",
          "format": [
            "void",
            "end_com_group_%n_%d_cleanup(struct end_com_group_%n_%d* coms) {",
            "%{  end_com_%l_cleanup(&coms->%l);  // %B%}",
            "}"
          ]
        },
        {
          "tag": "end_com_group",
          "format": [
            "void*",
            "end_com_group_%n_%d_get_com(struct end_com_group_%n_%d* coms, enum end_com_id com_id) {",
            "  switch (com_id) {",
            "%{  case END_COM_%L: return &coms->%l;  // %B%}",
            "  case END_COM_UNKNOWN_:",
            "    log_error(\"Unknown com %%i\", com_id);",
            "    return NULL;",
            "  default:",
            "    log_error(\"end_com_group_%n_%d does not have com %%i\", com_id);",
            "    return NULL;",
            "  }",
            "}"
          ]
        }
      ]
    }
  ]
}
